# Generated by ddev-sql-sync from .ddev/sql-sync/aliases.yml on every
# `ddev sql-sync` run — do not edit; edit aliases.yml instead.
# This file contains no secrets: the helpers read aliases.yml (including
# any database password pin) on the host at run time.
environment_variables:
  SQL_SYNC_SANITIZE: "true"
  SQL_SYNC_NO_DUMP: "0"
auth_command:
  command: |
    bash "$DDEV_APPROOT/.ddev/sql-sync/auth-check.sh" prod
  service: host
db_pull_command:
  command: |
    bash "$DDEV_APPROOT/.ddev/sql-sync/pull-db.sh" prod
  service: host
db_import_command:
  command: |
    bash "$DDEV_APPROOT/.ddev/sql-sync/import-db.sh" prod
  service: host
