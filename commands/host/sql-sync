#!/usr/bin/env bash
## #ddev-generated: This file is managed by the sql-sync add-on (atj4me/ddev-sql-sync). It will be overwritten on add-on updates; put your configuration in .ddev/sql-sync/aliases.yml instead.
## Description: Sync a database from a remote server into this DDEV project via ddev pull (ssh dump + rsync + import + sanitize)
## Usage: sql-sync @prod @self [--sanitize|--no-sanitize] [--dump-dir=<path>] [--no-dump] [--no-sync] [--dry-run] [-y]
## Example: "ddev sql-sync @prod @self" syncs the @prod alias into this project (Drush-style: source, then target)
## Example: "ddev sql-sync @prod @self --no-sanitize" syncs without scrubbing user emails/passwords

set -euo pipefail

APPROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
ADDON_DIR="$APPROOT/.ddev/sql-sync"
ALIASES_FILE="$ADDON_DIR/aliases.yml"
# shellcheck source=../../sql-sync/lib.sh
. "$ADDON_DIR/lib.sh"

usage() {
  cat <<'EOF'
Usage: ddev sql-sync <source> <target> [options]

Sync a MySQL database from a remote server into this DDEV project.
The sync itself is a real ddev pull: this command (re)generates a DDEV
provider for the alias from .ddev/sql-sync/aliases.yml on every run and
then runs `ddev pull <alias>`. The provider's stages create the dump on
the server over ssh, rsync it down and verify it against its completion
marker, import it, and sanitize. Once a provider has been generated you
can also run `ddev pull <alias>` directly.

  <source>          Alias from .ddev/sql-sync/aliases.yml, with or without the
                    leading @ (e.g. @prod). The alias gives the ssh host and
                    the app path on the server. Its platform defaults to this
                    project's DDEV type (.ddev/config.yaml) and can be set
                    per alias with the platform: key (laravel, wordpress,
                    drupal or php). The platform decides how the dump is made on the
                    server: the app's own export tool when it has one
                    (WP-CLI / Drush), otherwise mysqldump with credentials
                    from the alias's database: block and/or the app's own
                    config (.env, wp-config.php, settings.php).
                    An alias may set a jump: key (a bastion host) that is
                    passed to ssh -J for this sync. Prefer ProxyJump in
                    ~/.ssh/config for regular use; the jump: key is for
                    one-off syncs. An alias may set a files: key (a
                    user-files directory on the server) to have ddev pull
                    bring those files down too; without it, the pull is
                    database-only.
  <target>          The destination, stated like every unix copy/sync
                    command (cp, rsync, drush sql-sync): source first, then
                    target. Required, and only @self (this DDEV project) is
                    accepted — any other target is rejected, so the tool can
                    never write to a remote server.

Options:
  --sanitize        Sanitize after import (default): scrub user emails and
                    passwords in the local database.
  --no-sanitize     Skip the sanitize step. The local database will contain
                    real production emails and password hashes.
  --dump-dir=<path> Folder for the kept dump copy (overrides local.dir in
                    aliases.yml; default ~/sql-sync).
  --no-dump         Do not create a new dump; fetch the dump file left on
                    the server by an earlier run (see --no-sync). The
                    dump's completion marker must be present and match its
                    size, or the pull refuses to import.
  --no-sync         Only create the dump on the server (with its completion
                    marker); do not pull, import or sanitize. A later
                    --no-dump run fetches it. (Launcher-side: does not
                    invoke ddev pull.)
  --dry-run         Preflight only: check ssh connectivity, platform, dump
                    strategy, credentials (the password is never shown),
                    database size and disk space, then print the plan.
                    Takes no dump and imports nothing. (Launcher-side:
                    does not invoke ddev pull.)
  -y, --yes         Do not ask for confirmation (passed on to ddev pull).
  -h, --help        Show this help.
EOF
}

fail() { sqlsync_fail "$@"; }

# --- Parse arguments ---------------------------------------------------------

SOURCE=""
TARGET=""
SANITIZE="true"
DUMP_DIR_CLI=""
NO_DUMP="false"
NO_SYNC="false"
ASSUME_YES="false"
DRY_RUN="false"

while [ $# -gt 0 ]; do
  case "$1" in
    --sanitize) SANITIZE="true" ;;
    --no-sanitize) SANITIZE="false" ;;
    --dump-dir=*) DUMP_DIR_CLI="${1#--dump-dir=}" ;;
    --dump-dir)
      shift
      [ $# -gt 0 ] || fail "--dump-dir needs a path"
      DUMP_DIR_CLI="$1"
      ;;
    --no-dump) NO_DUMP="true" ;;
    --no-sync) NO_SYNC="true" ;;
    --dry-run) DRY_RUN="true" ;;
    -y|--yes) ASSUME_YES="true" ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "sql-sync: unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [ -z "$SOURCE" ]; then
        SOURCE="$1"
      elif [ -z "$TARGET" ]; then
        TARGET="$1"
      else
        fail "unexpected argument: $1"
      fi
      ;;
  esac
  shift
done

[ -n "$SOURCE" ] || { usage >&2; fail "a source alias is required, e.g. ddev sql-sync @prod @self"; }
ALIAS="${SOURCE#@}"
[ -n "$TARGET" ] || { usage >&2; fail "a target is required: sync commands take a source and a destination (e.g. ddev sql-sync @prod @self). Only @self is accepted as the target."; }
[ "$TARGET" = "@self" ] || fail "only @self is supported as the target in this version (got '$TARGET'). This tool never writes to a remote server."
if [ "$NO_DUMP" = "true" ] && [ "$NO_SYNC" = "true" ]; then
  fail "--no-dump and --no-sync together would not do anything: --no-dump expects a dump an earlier --no-sync run left on the server"
fi

# --- Load the alias ----------------------------------------------------------

load_alias "$ALIAS"

DUMP_DIR="$(resolve_dump_dir "$DUMP_DIR_CLI")"
mkdir -p "$DUMP_DIR"
DUMP_FILE="$DUMP_DIR/$ALIAS.sql"

echo "sql-sync: @$ALIAS ($SSH_TARGET:$ALIAS_ROOT, platform: $PLATFORM) -> @self"
echo "         dump file: $DUMP_FILE"

# --- Confirm (Drush-style) ---------------------------------------------------

if [ "$ASSUME_YES" != "true" ] && [ "$NO_SYNC" != "true" ] && [ "$DRY_RUN" != "true" ]; then
  echo "This will replace the database of this DDEV project with a dump from @$ALIAS."
  printf 'Continue? [y/N] '
  reply=""
  if [ -r /dev/tty ]; then
    read -r reply < /dev/tty || reply=""
  else
    read -r reply || reply=""
  fi
  case "$reply" in
    y|Y|yes|YES) ;;
    *) echo "Aborted."; exit 1 ;;
  esac
fi

# --- Dry run: preflight only -----------------------------------------------------

if [ "$DRY_RUN" = "true" ]; then
  echo "==> Dry run: preflight checks only — no dump, no download, no import."
  DRY_FAILED=""
  if [ -d "$DUMP_DIR" ] && [ -w "$DUMP_DIR" ]; then
    echo "preflight: ok: local dump dir $DUMP_DIR exists and is writable"
  else
    echo "preflight: FAIL: local dump dir $DUMP_DIR is not writable"
    DRY_FAILED=1
  fi
  REMOTE_OUT=""
  PREFLIGHT_RC=0
  # $SSH_OPTIONS is intentionally unquoted: it holds separate ssh options.
  REMOTE_OUT="$(ssh -o BatchMode=yes -o ConnectTimeout=10 $SSH_OPTIONS "$SSH_TARGET" "$REMOTE_ENV SQL_SYNC_PREFLIGHT=1 bash -s" < "$ADDON_DIR/remote-dump.sh" 2>&1)" || PREFLIGHT_RC=$?
  if [ "$PREFLIGHT_RC" -eq 0 ]; then
    echo "preflight: ok: ssh connectivity to $SSH_TARGET (BatchMode, 10s timeout)"
  else
    echo "preflight: FAIL: ssh preflight on $SSH_TARGET exited $PREFLIGHT_RC (connectivity or a remote check failed; remote output follows)"
    DRY_FAILED=1
  fi
  if [ -n "$REMOTE_OUT" ]; then
    printf '%s\n' "$REMOTE_OUT"
  fi
  SANITIZE_PLAN=""
  if [ "$SANITIZE" != "true" ]; then
    SANITIZE_PLAN="no (--no-sanitize)"
  elif [ -n "$SANITIZE_OVERRIDE" ]; then
    SANITIZE_PLAN="yes — the alias's sanitize file ($SANITIZE_KEY)"
  elif [ "$PLATFORM" = "drupal" ]; then
    if ddev drush --version >/dev/null 2>&1; then
      SANITIZE_PLAN="yes — drush sql-sanitize"
    else
      SANITIZE_PLAN="none available (drupal without drush or a sanitize file); a real run would stop with an error after import"
    fi
  elif [ "$PLATFORM" = "laravel" ]; then
    SANITIZE_PLAN="yes — built-in laravel sanitize (users table)"
  elif [ "$PLATFORM" = "wordpress" ]; then
    SANITIZE_PLAN="yes — built-in wordpress sanitize (the site's users table, prefix-aware)"
  else
    SANITIZE_PLAN="none available for platform '$PLATFORM'; a real run would stop with an error after import"
  fi
  echo "plan: the dump would be downloaded to $DUMP_FILE"
  echo "plan: sanitize after import: $SANITIZE_PLAN"
  echo "sql-sync: dry run complete. No dump was taken, nothing was imported, and nothing was written on the server."
  [ -z "$DRY_FAILED" ] || exit 1
  exit 0
fi

# --- --no-sync: dump on the server only --------------------------------------

if [ "$NO_SYNC" = "true" ]; then
  echo "==> Creating dump on $SSH_TARGET (no-sync) ..."
  STEP1_OUT=""
  STEP1_RC=0
  STEP1_OUT="$(ssh $SSH_OPTIONS "$SSH_TARGET" "$REMOTE_ENV bash -s" < "$ADDON_DIR/remote-dump.sh" 2>&1)" || STEP1_RC=$?
  [ -n "$STEP1_OUT" ] && printf '%s\n' "$STEP1_OUT"
  if [ "$STEP1_RC" -ne 0 ]; then
    fail "the dump step failed on $SSH_TARGET (exit $STEP1_RC); nothing was downloaded or imported"
  fi
  echo "==> --no-sync: dump left on $SSH_TARGET at $REMOTE_FILE (with its completion marker); nothing downloaded or imported."
  echo "    Fetch and import it later with: ddev sql-sync @$ALIAS @self --no-dump"
  exit 0
fi

# --- Optional pre-pull snapshot of the local database -------------------------

if [ "$LOCAL_SNAPSHOT" = "true" ]; then
  SNAP_NAME="sql-sync-$ALIAS-$(date +%Y%m%d-%H%M%S)"
  echo "==> Taking a snapshot of the local database first: $SNAP_NAME (local.snapshot: true)"
  ddev snapshot --name="$SNAP_NAME" || fail "the pre-sync snapshot failed; aborting before the pull"
fi

# --- Generate the provider and pull -------------------------------------------

NO_DUMP_ENV="0"
[ "$NO_DUMP" = "true" ] && NO_DUMP_ENV="1"
PROVIDER_FILE="$APPROOT/.ddev/providers/$ALIAS.yaml"
mkdir -p "$APPROOT/.ddev/providers"
{
  cat <<EOF
# Generated by ddev-sql-sync from .ddev/sql-sync/aliases.yml on every
# \`ddev sql-sync\` run — do not edit; edit aliases.yml instead.
# This file contains no secrets: the helpers read aliases.yml (including
# any database password pin) on the host at run time.
environment_variables:
  SQL_SYNC_SANITIZE: "$SANITIZE"
  SQL_SYNC_NO_DUMP: "$NO_DUMP_ENV"
auth_command:
  command: |
    bash "\$DDEV_APPROOT/.ddev/sql-sync/auth-check.sh" $ALIAS
  service: host
db_pull_command:
  command: |
    bash "\$DDEV_APPROOT/.ddev/sql-sync/pull-db.sh" $ALIAS
  service: host
db_import_command:
  command: |
    bash "\$DDEV_APPROOT/.ddev/sql-sync/import-db.sh" $ALIAS
  service: host
EOF
  if [ -n "$DUMP_DIR_CLI" ]; then
    cat <<EOF
  SQL_SYNC_DUMP_DIR: "$DUMP_DIR_CLI"
EOF
  fi
  if [ -n "$FILES_DIR" ]; then
    cat <<EOF
files_pull_command:
  command: |
    bash "\$DDEV_APPROOT/.ddev/sql-sync/pull-files.sh" $ALIAS
  service: host
EOF
  fi
} > "$PROVIDER_FILE"
echo "==> Provider regenerated: .ddev/providers/$ALIAS.yaml"

PULL_ARGS=("$ALIAS")
if [ -z "$FILES_DIR" ]; then
  PULL_ARGS+=("--skip-files")
fi
# Per-run values travel in the generated provider's environment_variables:
# DDEV (v1.25.5) honours only the last --environment flag on ddev pull.
if [ "$ASSUME_YES" = "true" ]; then
  PULL_ARGS+=("-y")
fi

echo "==> ddev pull ${PULL_ARGS[*]}"
if ! ddev pull "${PULL_ARGS[@]}"; then
  fail "ddev pull $ALIAS failed (see the output above)"
fi
